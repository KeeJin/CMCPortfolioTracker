# Lightweight backend server environment
# Used by: src/app.ts (Render or local server runtime)

PORT=3001
NODE_ENV=production
SESSION_SECRET=your-session-secret-placeholder

# Google auth allowlist
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_EMAIL=your-email@gmail.com

# Frontend + CORS
FRONTEND_URL=https://your-frontend-domain.vercel.app
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Supabase source-of-truth datastore
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Keep disabled for the lightweight deployment mode
ENABLE_BACKGROUND_PREFETCH=false

