{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,mjs,cjs,json --ignore 'data/**' --ignore 'dist/**' --exec \"node --loader ts-node/esm src/app.ts\"",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "validate:pdf-samples": "node --loader ts-node/esm scripts/validatePdfSamples.ts",
    "refresh:processed-cache": "node --loader ts-node/esm scripts/manual-refresh-processed-cache.ts"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@supabase/supabase-js": "^2.53.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.4.0",
    "multer": "^2.1.1",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
